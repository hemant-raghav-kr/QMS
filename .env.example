# ==============================================================================
# QUARTZITE MANAGEMENT SYSTEM (QMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as '.env.local' and supply your project-specific values.
# DO NOT commit real secrets or production credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (New API Keys)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Project Settings > API
#
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_URL=https://your-project.supabase.co (optional alias for server-side)

# Publishable Key (Client-Safe):
# Used in browser and server for client sessions, auth listeners, and RLS enforcement.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_pub_your-supabase-publishable-key
# Legacy alias fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Secret Key (SERVER-ONLY - Keep strictly confidential, NEVER expose to client):
# Used exclusively in backend administrative functions (admin.ts, cron, system backups).
# NEVER prefix with NEXT_PUBLIC_* or expose in frontend code.
SUPABASE_SECRET_KEY=sb_sec_your-supabase-secret-key
# Legacy alias fallback: SUPABASE_SERVICE_ROLE_KEY=...

# JWKS URL (Optional, for JWT token verification):
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 2. APPLICATION URL
# ------------------------------------------------------------------------------
# Base URL of the application. Used for OAuth redirects, magic links, and PWA metadata.
# Production: https://qms.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. LIVEKIT SFU MEDIA INFRASTRUCTURE (Video, Audio, Screen Sharing)
# ------------------------------------------------------------------------------
# Obtain from LiveKit Cloud (https://cloud.livekit.io) or self-hosted LiveKit instance.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Generate VAPID key pair via: npx web-push generate-vapid-keys
# Public key is exposed to browser for PushSubscription creation; Private key stays on server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL SERVICES (Resend or Direct SMTP / Gmail)
# ------------------------------------------------------------------------------
# Option A: Resend Transactional Email (https://resend.com/api-keys)
# Note: Resend requires a verified custom domain to dispatch to arbitrary personal emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WEEKLY_REPORT_EMAIL=

# Option B: Direct SMTP (e.g. Gmail with 16-character Google App Password)
# Enables direct delivery to all admins' personal email accounts without needing custom domain DNS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------------------
# 6. SCHEDULED CRON & BACKGROUND WORKER AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret token used by Vercel Cron, GitHub Actions, or curl to trigger:
# - /api/cron/reminders (T-30, T-10, T=0 meeting reminders)
# - /api/cron/weekly-report (Monday 00:00 UTC compliance point backup)
# Pass in request header: "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=your-secure-random-cron-secret-token-32-chars-min
